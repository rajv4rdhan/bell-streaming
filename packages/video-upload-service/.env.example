# Server Configuration
PORT=3003
NODE_ENV=development

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=bell-streaming-videos
S3_PRESIGNED_URL_EXPIRATION=900
S3_VIDEO_KEY_PREFIX=videos
# Optional: custom S3-compatible endpoint (for example MinIO)
# S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=false
# Optional: public base URL for objects (for example a CDN)
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: public S3 endpoint used for browser uploads (for example MinIO)
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Video Metadata Service
VIDEO_METADATA_SERVICE_URL=http://localhost:3002/api/videos

# JWT Configuration (for auth verification)
JWT_SECRET=your-super-secret-jwt-key

# File Upload Limits
MAX_FILE_SIZE_MB=500
UPLOAD_TIMEOUT_MS=1800000
UPLOAD_MONITOR_INTERVAL_MS=300000
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm,video/x-matroska
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.webm,.mkv,.mpeg,.mpg

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Kafka (optional)
KAFKA_ENABLED=true
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=video-upload-service
# KAFKA_TOPIC=video-uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
