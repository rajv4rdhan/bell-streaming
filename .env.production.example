# MongoDB Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bell-streaming

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Public URL used by services when generating links
PUBLIC_URL=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name
S3_PRESIGNED_URL_EXPIRATION=900
# Optional S3-compatible endpoint (for example MinIO)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional public object base URL (for example CloudFront)
S3_PUBLIC_BASE_URL=
S3_VIDEO_KEY_PREFIX=videos
DEFAULT_THUMBNAIL_URL=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081

# Video Upload Configuration
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm,video/x-matroska
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.webm,.mkv,.mpeg,.mpg
MAX_FILE_SIZE_MB=500

# Optional Kafka configuration (required if video.uploaded events are consumed)
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=video-upload-service
# KAFKA_TOPIC=video-uploads
