logging {
  level  = "info"
  format = "logfmt"
}

// ====================
// PROMETHEUS METRICS
// ====================

// 1. Configure the Scraper (Alloy itself)
prometheus.exporter.self "alloy" {}
prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.default.receiver]
}

// 2. Configure Node Exporter (Host Metrics)
prometheus.exporter.unix "node" {
  enable_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "loadavg", "netdev", "netstat", "time", "uname"]
}
prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.default.receiver]
}

// 3. Configure cAdvisor (Container Metrics)
prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"
  store_container_labels = true
  docker_only = true
  disable_root_cgroup_stats = false
}

prometheus.scrape "cadvisor" {
  targets    = prometheus.exporter.cadvisor.containers.targets
  forward_to = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = "15s"
}

// 4. Relabel cAdvisor (FIXED: Valid Syntax)
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.default.receiver]

  // Rule 1: Extract service name from Docker Compose label
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Rule 2: Initialize 'container' label using 'id' (The Fallback)
  rule {
    source_labels = ["id"]
    target_label  = "container"
  }

  // Rule 3: If 'name' is NOT empty, overwrite 'container' with 'name'
  rule {
    source_labels = ["name"]
    regex         = "(.+)"  // Only match if name has characters
    target_label  = "container"
  }
}

// 5. Scrape Your App Services
prometheus.scrape "services" {
  targets = [
    { "__address__" = "auth-service:3001", "job" = "auth-service" },
    { "__address__" = "video-upload-service:3004", "job" = "video-upload-service" },
    { "__address__" = "video-metadata-service:3002", "job" = "video-metadata-service" },
    { "__address__" = "streaming-service:3003", "job" = "streaming-service" },
  ]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 6. Send to Prometheus
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ====================
// LOKI LOGS
// ====================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["logging=alloy"]
  }
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.container_logs.output
  forward_to       = [loki.write.default.receiver]
  refresh_interval = "5s"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}